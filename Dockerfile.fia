FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --package-lock=false --no-audit --no-fund
COPY . .
RUN FIA_ALLOW_DIRTY=1 npm run fia:build

FROM node:22-alpine AS runtime
WORKDIR /srv/fia
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080 FIA_ROOT=/srv/fia/dist
COPY --from=build /app/dist ./dist
COPY --from=build /app/artifacts ./artifacts
COPY tools/serve-owned.mjs ./serve-owned.mjs
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -qO- http://127.0.0.1:8080/_health || exit 1
CMD ["node", "serve-owned.mjs"]
