{
  admin 127.0.0.1:2019
  auto_https off
  persist_config off
}

:8080 {
  root * /var/lib/foundation-intelligence/current
  encode zstd gzip

  @health path /healthz
  respond @health 200 {
    body "foundation-intelligence-runtime:ok"
    close
  }

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    -Server
  }

  try_files {path} /index.html
  file_server
  log {
    output file /var/log/foundation-intelligence/access.json {
      roll_size 20MiB
      roll_keep 10
      roll_keep_for 720h
    }
    format json
  }
}
