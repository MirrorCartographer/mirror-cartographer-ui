    {"id":"runtime-c","domain":"site-c","image_digest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","kernel":"6.12.22","firmware_inventory":true,"drift_clear":true}
