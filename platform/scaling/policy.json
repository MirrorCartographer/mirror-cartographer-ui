{
  "version": 1,
  "authority": {
    "project_controls_capacity_policy": true,
    "provider_autoscaling_authoritative": false,
    "desired_state_exportable": true,
    "manual_override_audited": true,
    "destructive_scale_actions_require_operators": 2
  },
  "workload": {
    "classification_required": true,
    "stateless_horizontal_scaling": true,
    "stateful_scaling_requires_service_native_plan": true,
    "minimum_ready_replicas": 2,
    "maximum_replicas_explicit": true,
    "failure_domains_minimum": 2,
    "readiness_gates_required": true,
    "startup_warmup_excluded_from_metrics": true,
    "graceful_drain_required": true,
    "termination_budget_seconds": 60
  },
  "signals": {
    "multiple_independent_metrics": true,
    "saturation_metric_required": true,
    "queue_age_or_backlog_required_for_async": true,
    "request_rate_or_concurrency_required_for_sync": true,
    "metrics_freshness_limit_seconds": 60,
    "missing_metrics_fail_closed_for_scale_down": true,
    "provider_metric_sole_signal": false
  },
  "control_loop": {
    "scale_up_max_delay_seconds": 30,
    "scale_down_stabilization_seconds": 300,
    "scale_down_max_percent_per_minute": 10,
    "cooldown_seconds": 300,
    "scale_to_zero_for_critical_services": false,
    "anti_flap_hysteresis": true,
    "bounded_rate_of_change": true
  },
  "capacity": {
    "headroom_percent": 30,
    "reserved_failure_capacity": true,
    "admission_control_required": true,
    "load_shedding_required": true,
    "backpressure_required": true,
    "bounded_queues_required": true,
    "priority_classes_required": true,
    "capacity_exhaustion_alert_percent": 70
  },
  "dependency_limits": {
    "database_connection_budget_required": true,
    "queue_consumer_budget_required": true,
    "external_api_budget_required": true,
    "per_replica_resource_requests_and_limits": true,
    "downstream_capacity_must_scale_or_throttle": true
  },
  "verification": {
    "load_test_required": true,
    "failure_domain_loss_test_required": true,
    "metric_loss_test_required": true,
    "thundering_herd_test_required": true,
    "cold_start_benchmark_required": true,
    "signed_capacity_evidence": true,
    "evidence_max_age_days": 30,
    "provider_outage_scale_path": true,
    "public_dns_not_required_for_manual_scale": true
  }
}
