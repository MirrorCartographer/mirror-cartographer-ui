{
  "schema_version": 1,
  "authority": {
    "project_owned_database_policy": true,
    "patroni_authoritative": false,
    "cloud_database_authoritative": false,
    "schema_registry_owned_by_project": true,
    "migration_ledger_owned_by_project": true,
    "database_adapter_replaceable": true
  },
  "topology": {
    "minimum_database_nodes": 3,
    "minimum_failure_domains": 3,
    "single_writer": true,
    "synchronous_mode": "strict",
    "synchronous_node_count": 1,
    "quorum_dcs_nodes": 3,
    "watchdog_required": true,
    "split_brain_fencing_required": true,
    "application_superuser_forbidden": true
  },
  "durability": {
    "data_checksums_required": true,
    "full_page_writes_required": true,
    "wal_archiving_required": true,
    "replication_slots_bounded": true,
    "max_slot_wal_keep_size_required": true,
    "critical_transactions_sync_commit_enforced": true,
    "client_override_sync_commit_forbidden": true,
    "maximum_failover_lag_bytes": 0,
    "acknowledged_loss_tested": true
  },
  "failover": {
    "automatic_failover_allowed": true,
    "manual_failover_requires_two_operators": true,
    "manual_data_loss_override_separate": true,
    "timeline_check_required": true,
    "candidate_lag_check_required": true,
    "old_primary_fenced_before_promotion": true,
    "pg_rewind_allowed": true,
    "fresh_base_backup_fallback_required": true,
    "dcs_loss_behavior_tested": true
  },
  "migrations": {
    "source_controlled": true,
    "immutable_ids": true,
    "checksummed": true,
    "expand_contract_required": true,
    "backward_compatible_release_window": true,
    "lock_timeout_required": true,
    "statement_timeout_required": true,
    "destructive_changes_two_operator": true,
    "backfill_batched": true,
    "backfill_resumable": true,
    "backfill_rate_limited": true,
    "schema_drift_blocks_deploy": true,
    "down_migration_not_assumed_safe": true
  },
  "logical_migration": {
    "ddl_replication_assumed": false,
    "sequence_replication_assumed": false,
    "schema_applied_before_data": true,
    "replica_identity_required": true,
    "slot_migration_version_floor": 17,
    "cutover_write_fence_required": true,
    "source_retained_until_reconciliation": true
  },
  "continuity": {
    "original_provider_required": false,
    "public_dns_required": false,
    "patroni_required_for_restore": false,
    "cross_implementation_export_required": true,
    "clean_host_restore_max_age_days": 30,
    "minimum_trained_operators": 2
  },
  "evidence": {
    "machine_generated": true,
    "signed": true,
    "contains_cluster_system_identifier": true,
    "contains_timeline_and_lsn": true,
    "contains_replica_flush_lsn": true,
    "contains_schema_digest": true,
    "contains_migration_ledger_digest": true,
    "contains_failover_result": true,
    "contains_data_loss_measurement": true,
    "contains_operator_signatures": true,
    "retention_days": 2555
  }
}
