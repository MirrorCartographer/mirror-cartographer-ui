{
  "schema_version": 1,
  "authority": {
    "identity_namespace_owned_by_project": true,
    "secret_policy_owned_by_project": true,
    "provider_iam_authoritative": false,
    "hosted_vault_authoritative": false,
    "canonical_inventory_exportable": true
  },
  "identity": {
    "standard": "SPIFFE",
    "implementation": "SPIRE",
    "trust_domains": ["prod.foundation.internal", "staging.foundation.internal"],
    "root_keys_reused": false,
    "workload_api_endpoint": "unix:///run/spire/agent.sock",
    "shared_across_hosts": false,
    "x509_svid_ttl_minutes": 30,
    "static_workload_credentials": false,
    "node_attestation": true,
    "workload_selectors": true,
    "bundle_rotation": true,
    "bundle_sequence_persisted": true
  },
  "secrets": {
    "implementation": "Vault-compatible project broker",
    "dynamic_credentials_preferred": true,
    "static_secret_exception_registry": true,
    "leases": true,
    "maximum_workload_lease_minutes": 30,
    "automatic_revocation": true,
    "secret_values_in_images": false,
    "secret_values_in_source": false,
    "secret_values_in_ci_logs": false,
    "secret_values_in_environment_exports": false,
    "authenticated_local_delivery": true,
    "single_use_bootstrap": true,
    "kv_versioning": true,
    "destroy_permission_separate": true
  },
  "control_plane": {
    "identity_servers": [
      {"id":"spire-a","domain":"site-a"},
      {"id":"spire-b","domain":"site-b"},
      {"id":"spire-c","domain":"site-c"}
    ],
    "secret_servers": [
      {"id":"secret-a","domain":"site-a"},
      {"id":"secret-b","domain":"site-b"},
      {"id":"secret-c","domain":"site-c"}
    ],
    "quorum_storage": true,
    "single_writer_or_consensus": true,
    "public_dns_required": false,
    "public_ca_required": false,
    "cloud_kms_required": false,
    "offline_recovery_quorum": true,
    "recovery_shares": 5,
    "recovery_threshold": 3
  },
  "authorization": {
    "default_deny": true,
    "least_privilege": true,
    "mapping_source_controlled": true,
    "human_workload_separation": true,
    "break_glass_separate": true,
    "root_operator_count": 2,
    "release_keys_present": false
  },
  "rotation": {
    "automatic_workload_rotation": true,
    "root_rotation_runbook": true,
    "intermediate_overlap": true,
    "static_secret_rotation_days": 60,
    "last_compromise_drill_age_days": 20,
    "measured_revocation_seconds": 120
  },
  "backup_restore": {
    "encrypted_snapshots": true,
    "copies": 3,
    "offline_copy": true,
    "identity_roots_separate": true,
    "isolated_restore": true,
    "without_original_provider": true,
    "without_public_dns": true,
    "last_restore_drill_age_days": 12,
    "cross_implementation_export": true
  },
  "audit": {
    "secret_reads": true,
    "policy_changes": true,
    "values_redacted": true,
    "external_store": true,
    "restore_evidence_signed": true,
    "rotation_evidence_signed": true,
    "retention_days": 2555
  }
}
