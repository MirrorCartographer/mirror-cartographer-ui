{
  "schema": "foundation.secret-catalog.v1",
  "generation": 1,
  "trust_domain": "foundation.internal",
  "bootstrap": {
    "online_secret_store_required": false,
    "offline_root_quorum": 2,
    "offline_root_holders": 3,
    "recovery_catalog_required": true
  },
  "classes": {
    "dynamic-database": {
      "maximum_ttl_seconds": 900,
      "renewable": true,
      "storage": "never-persist-in-kubernetes",
      "rotation": "on-demand-and-expiry"
    },
    "static-third-party": {
      "maximum_ttl_seconds": 2592000,
      "renewable": false,
      "storage": "encrypted-external-secret-store",
      "rotation": "catalog-scheduled"
    },
    "bootstrap-root": {
      "maximum_ttl_seconds": 0,
      "renewable": false,
      "storage": "offline-threshold-custody",
      "rotation": "ceremony-only"
    }
  },
  "workloads": {
    "spiffe://foundation.internal/reader/api": {
      "allowed_secret_classes": ["dynamic-database"],
      "allowed_paths": ["database/reader"],
      "maximum_ttl_seconds": 900,
      "environment_injection": false,
      "file_injection": true
    }
  }
}
