{
  "schema_version": 1,
  "authority": {
    "identity_namespace_owned_by_project": true,
    "secret_policy_owned_by_project": true,
    "provider_iam_authoritative": false,
    "hosted_vault_authoritative": false,
    "canonical_secret_inventory_exportable": true
  },
  "identity": {
    "standard": "SPIFFE",
    "implementation": "SPIRE",
    "trust_domains_separated_by_environment": true,
    "root_keys_reused_across_trust_domains": false,
    "workload_api_local_only": true,
    "workload_api_shared_across_hosts": false,
    "short_lived_x509_svids": true,
    "maximum_svid_ttl_minutes": 60,
    "static_workload_credentials_forbidden": true,
    "node_attestation_required": true,
    "workload_selectors_required": true,
    "bundle_rotation_required": true,
    "bundle_sequence_persisted": true
  },
  "secrets": {
    "dynamic_credentials_preferred": true,
    "static_secrets_exception_only": true,
    "leases_required": true,
    "maximum_workload_lease_minutes": 60,
    "automatic_revocation_required": true,
    "secret_values_forbidden_in_images": true,
    "secret_values_forbidden_in_source": true,
    "secret_values_forbidden_in_ci_logs": true,
    "secret_values_forbidden_in_environment_exports": true,
    "delivery_via_authenticated_local_channel": true,
    "response_wrapping_or_single_use_bootstrap": true,
    "kv_versioning_required_for_static_secrets": true,
    "permanent_destroy_separated_from_soft_delete": true
  },
  "control_plane": {
    "minimum_identity_servers": 3,
    "minimum_secret_servers": 3,
    "minimum_failure_domains": 3,
    "quorum_storage_required": true,
    "single_writer_or_consensus_required": true,
    "public_dns_required_for_operation": false,
    "public_ca_required_for_internal_operation": false,
    "cloud_kms_required_for_unseal": false,
    "offline_unseal_or_recovery_quorum": true,
    "minimum_recovery_shares": 5,
    "minimum_recovery_threshold": 3
  },
  "authorization": {
    "default_deny": true,
    "least_privilege": true,
    "identity_to_policy_mapping_source_controlled": true,
    "human_and_workload_identity_separated": true,
    "break_glass_separate": true,
    "two_operator_root_or_recovery_actions": true,
    "release_keys_not_held_by_secret_servers": true
  },
  "rotation": {
    "automatic_workload_rotation": true,
    "root_rotation_runbook": true,
    "intermediate_overlap_required": true,
    "static_secret_rotation_max_days": 90,
    "credential_compromise_drill_max_days": 90,
    "revocation_propagation_objective_seconds": 300
  },
  "backup_restore": {
    "encrypted_snapshots_required": true,
    "three_copies_required": true,
    "offline_copy_required": true,
    "identity_roots_backed_up_separately": true,
    "restore_isolated": true,
    "restore_without_original_provider": true,
    "restore_without_public_dns": true,
    "restore_drill_max_age_days": 30,
    "cross_implementation_export_required": true
  },
  "audit": {
    "all_secret_reads_audited": true,
    "all_policy_changes_audited": true,
    "audit_logs_redact_secret_values": true,
    "audit_logs_external_to_secret_cluster": true,
    "signed_restore_evidence": true,
    "signed_rotation_evidence": true,
    "retention_days": 2555
  }
}
