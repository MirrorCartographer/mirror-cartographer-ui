    "offline_ksk_or_equivalent": true,
    "online_zsk_separate": true,
    "minimum_ksk_copies": 3,
    "minimum_ksk_failure_domains": 2,
    "prepublication_rollover": true,
    "signature_expiry_alert_hours": 72,
    "parent_ds_verified": true,
    "cds_cdnskey_continuity_checked": true,
    "algorithm_migration_tested": true
  },
  "publishing": {
    "atomic_generation_required": true,
    "multi_provider_publish_required": true,
    "provider_api_credentials_separated": true,
