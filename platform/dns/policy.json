    "provider_loss_tested": true
  },
  "resilience": {
    "one_authoritative_server_loss": true,
    "one_dns_operator_loss": true,
    "registrar_outage": true,
    "dnssec_signer_loss": true,
    "bad_zone_rejected": true,
    "bad_ds_rejected": true,
    "expired_signature_tested": true,
