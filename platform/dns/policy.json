  "security": {
    "mfa_required": true,
    "phishing_resistant_mfa_preferred": true,
    "shared_email_as_sole_recovery_forbidden": true,
    "dns_api_credentials_on_edge_forbidden": true,
    "release_keys_on_dns_hosts_forbidden": true,
    "audit_log_externalized": true,
    "least_privilege_updates": true
  },
  "evidence": {
    "machine_generated": true,
    "signed": true,
    "zone_digest": true,
    "served_rrset_digest": true,
    "delegation_digest": true,
    "dnssec_chain_validation": true,
    "multi_vantage_probe": true,
    "registrar_status": true,
    "operator_signatures": 2,
    "retention_days": 2555
