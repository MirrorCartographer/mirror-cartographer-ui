{
  "schema_version": 1,
  "authority": {
    "project_owned_zone_source": true,
    "registrar_authoritative_for_zone_content": false,
    "dns_provider_authoritative_for_zone_content": false,
    "canonical_zone_exportable": true,
    "provider_adapter_replaceable": true,
    "domain_registration_unavoidably_external": true
  },
  "domain": {
    "registrant_identity_project_controlled": true,
    "registrar_lock_required": true,
    "registry_lock_preferred": true,
    "auto_renew_required": true,
