{
  admin off
  servers {
    protocols h1 h2 h3
  }
}

{$FOUNDATION_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }

  # Foundation currently exposes a static artifact and health endpoint. Bound
  # request bodies at the edge so an unauthenticated client cannot force Caddy
  # to accept arbitrarily large uploads that the application does not need.
  request_body {
    max_size 1MiB
  }

  @health path /healthz
  handle @health {
    reverse_proxy app:8080 {
      transport http {
        dial_timeout 3s
        response_header_timeout 15s
        max_response_header 1MiB
        max_conns_per_host 256
      }
    }
  }

  handle {
    reverse_proxy app:8080 {
      transport http {
        dial_timeout 3s
        response_header_timeout 15s
        max_response_header 1MiB
        max_conns_per_host 256
      }
    }
  }

  log {
    output file /data/access.log {
      roll_size 25MiB
      roll_keep 5
      roll_keep_for 168h
    }
    format json
  }
}
