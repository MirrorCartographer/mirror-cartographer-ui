#cloud-config
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - git
  - jq
  - ufw
  - fail2ban
  - unattended-upgrades
  - gnupg

users:
  - default
  - name: ${admin_user}
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys: []

write_files:
  - path: /etc/sysctl.d/99-foundation.conf
    permissions: '0644'
    content: |
      net.ipv4.ip_forward=1
      net.ipv4.conf.all.rp_filter=1
      net.ipv4.conf.default.rp_filter=1
      net.ipv4.tcp_syncookies=1
  - path: /etc/fail2ban/jail.d/sshd.local
    permissions: '0644'
    content: |
      [sshd]
      enabled = true
      maxretry = 5
      findtime = 10m
      bantime = 1h
  - path: /etc/systemd/system/srv-foundation.mount
    permissions: '0644'
    content: |
      [Unit]
      Description=Foundation persistent data volume
      Requires=dev-disk-by\x2did-scsi\x2d0HC_Volume_${volume_id}.device
      After=dev-disk-by\x2did-scsi\x2d0HC_Volume_${volume_id}.device
      Before=docker.service

      [Mount]
      What=/dev/disk/by-id/scsi-0HC_Volume_${volume_id}
      Where=/srv/foundation
      Type=ext4
      Options=defaults,noatime

      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/srv-foundation.automount
    permissions: '0644'
    content: |
      [Unit]
      Description=Automount Foundation persistent data volume
      Before=docker.service

      [Automount]
      Where=/srv/foundation
      TimeoutIdleSec=0

      [Install]
      WantedBy=multi-user.target
  - path: /opt/foundation/.env
    permissions: '0600'
    content: |
      FOUNDATION_DOMAIN=${domain}
      FOUNDATION_REPO=${repo_url}
      FOUNDATION_REF=${repo_ref}
  - path: /opt/foundation/deploy.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail
      source /opt/foundation/.env
      mountpoint -q /srv/foundation || {
        echo "Foundation persistent volume is not mounted; refusing deployment" >&2
        exit 1
      }
      install -d -m 0755 /opt/foundation/src /srv/foundation/releases /srv/foundation/data /srv/foundation/backups
      if [ ! -d /opt/foundation/src/.git ]; then
        git clone --branch "$FOUNDATION_REF" --single-branch "$FOUNDATION_REPO" /opt/foundation/src
      else
        git -C /opt/foundation/src fetch origin "$FOUNDATION_REF"
        git -C /opt/foundation/src checkout -f "$FOUNDATION_REF"
        git -C /opt/foundation/src reset --hard "origin/$FOUNDATION_REF"
      fi
      COMMIT="$(git -C /opt/foundation/src rev-parse HEAD)"
      RELEASE="/srv/foundation/releases/$COMMIT"
      if [ ! -d "$RELEASE" ]; then
        mkdir -p "$RELEASE"
        docker build --pull --label "org.opencontainers.image.revision=$COMMIT" -f /opt/foundation/src/platform/Containerfile -t "foundation-ui:$COMMIT" /opt/foundation/src
        docker image inspect "foundation-ui:$COMMIT" > "$RELEASE/image-inspect.json"
        printf '%s\n' "$COMMIT" > "$RELEASE/commit"
      fi
      export FOUNDATION_IMAGE="foundation-ui:$COMMIT"
      export FOUNDATION_DOMAIN
      docker compose -f /opt/foundation/src/platform/host/compose.production.yaml up -d --remove-orphans
      printf '%s\n' "$COMMIT" > /srv/foundation/current
      curl --fail --retry 20 --retry-delay 3 "https://$FOUNDATION_DOMAIN/healthz"
  - path: /opt/foundation/backup.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail
      mountpoint -q /srv/foundation || {
        echo "Foundation persistent volume is not mounted; refusing backup" >&2
        exit 1
      }
      stamp="$(date -u +%Y%m%dT%H%M%SZ)"
      tar --xattrs --acls -C /srv/foundation -czf "/srv/foundation/backups/foundation-$stamp.tar.gz" data current releases
      find /srv/foundation/backups -type f -mtime +14 -delete
  - path: /etc/systemd/system/foundation-backup.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Foundation Intelligence backup
      RequiresMountsFor=/srv/foundation
      [Service]
      Type=oneshot
      ExecStart=/opt/foundation/backup.sh
  - path: /etc/systemd/system/foundation-backup.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Daily Foundation Intelligence backup
      [Timer]
      OnCalendar=daily
      Persistent=true
      RandomizedDelaySec=900
      [Install]
      WantedBy=timers.target

runcmd:
  - sysctl --system
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list'
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - install -d -m 0755 /srv/foundation
  - systemctl daemon-reload
  - 'for attempt in $(seq 1 60); do test -b /dev/disk/by-id/scsi-0HC_Volume_${volume_id} && exit 0; sleep 2; done; echo "Foundation volume device did not appear" >&2; exit 1'
  - systemctl enable --now srv-foundation.automount
  - 'ls -la /srv/foundation >/dev/null'
  - 'findmnt --mountpoint /srv/foundation --source /dev/disk/by-id/scsi-0HC_Volume_${volume_id} >/dev/null || { echo "Foundation volume identity mismatch" >&2; exit 1; }'
  - systemctl enable --now docker fail2ban unattended-upgrades
  - systemctl enable --now foundation-backup.timer
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow OpenSSH
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw allow 443/udp
  - ufw --force enable
  - chown -R ${admin_user}:${admin_user} /opt/foundation /srv/foundation

final_message: "Foundation host bootstrap complete with verified persistent volume. Set DNS, then run /opt/foundation/deploy.sh."
