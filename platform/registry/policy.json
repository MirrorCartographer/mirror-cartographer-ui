{
  "schema_version": 1,
  "authority": {
    "project_owned_artifact_catalog": true,
    "registry_database_authoritative": false,
    "provider_registry_authoritative": false,
    "release_uses_digest_only": true,
    "tags_authorize_release": false,
    "registry_adapter_replaceable": true,
    "oci_portable": true
  },
  "custody": {
    "minimum_complete_registry_copies": 2,
    "minimum_failure_domains": 2,
    "offline_oci_export_required": true,
    "project_controlled_copy_required": true,
    "canonical_manifest_signed": true,
    "referrers_included": true,
    "original_registry_required_for_restore": false
  },
  "publication": {
    "artifact_digest_reverified_before_push": true,
    "artifact_digest_reverified_after_pull": true,
    "manifest_bytes_preserved": true,
    "immutable_release_tags": true,
    "mutable_convenience_tags_non_authoritative": true,
    "promotion_by_manifest_digest": true,
    "push_credentials_cannot_delete": true,
    "delete_credentials_separate": true
  },
  "replication": {
    "digest_reconciliation_required": true,
    "copy_referrers_required": true,
    "deletion_replication_disabled_by_default": true,
    "bandwidth_limit_required": true,
    "lag_alert_seconds": 900,
    "same_product_not_required": true,
    "partial_failure_retriable": true
  },
  "garbage_collection": {
    "source_controlled_retention": true,
    "dry_run_required": true,
    "minimum_grace_hours": 48,
    "release_reachability_graph_required": true,
    "offline_copy_verified_before_delete": true,
    "two_operator_delete_authority": true,
    "writer_cannot_run_gc": true,
    "deletion_evidence_signed": true,
    "repair_or_gc_never_runs_on_only_copy": true
  },
  "security": {
    "short_lived_robot_credentials": true,
    "least_privilege_repository_scope": true,
    "anonymous_push_forbidden": true,
    "release_keys_forbidden_on_registry_hosts": true,
    "scanner_cannot_promote": true,
    "registry_network_default_deny": true,
    "storage_keys_separate_from_registry_admin": true,
    "audit_externalized": true
  },
  "integrity": {
    "sha256_required": true,
    "size_verified": true,
    "complete_dag_walk_required": true,
    "orphan_detection_required": true,
    "periodic_full_read_max_age_days": 30,
    "sample_restore_max_age_days": 7,
    "cross_implementation_restore_required": true
  },
  "continuity": {
    "github_not_required": true,
    "public_dns_not_required": true,
    "public_ca_not_required": true,
    "hosted_registry_not_required": true,
    "clean_host_restore_max_age_days": 30,
    "minimum_trained_operators": 2
  },
  "evidence": {
    "machine_generated": true,
    "signed": true,
    "catalog_digest": true,
    "manifest_and_blob_digests": true,
    "referrer_graph_digest": true,
    "replication_receipts": true,
    "gc_candidate_digest": true,
    "restore_receipt": true,
    "operator_signatures": 2,
    "retention_days": 2555
  },
  "packages": {
    "lockfile_required": true,
    "tarball_digest_required": true,
    "metadata_snapshot_required": true,
    "complete_transitive_closure_required": true,
    "install_from_project_mirror": true,
    "canonical_build_network_denied": true,
    "lifecycle_scripts_default_deny": true,
    "mirror_exportable": true,
    "upstream_yank_does_not_break_restore": true
  }
}
