:8080 {
  root * /srv
  encode zstd gzip

  @health path /healthz
  respond @health 200 {
    body "foundation-intelligence-runtime:ok"
    close
  }

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }

  try_files {path} /index.html
  file_server
}
