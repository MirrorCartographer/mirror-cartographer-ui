{
	admin 127.0.0.1:2019
	email {$ACME_ACCOUNT_EMAIL}
	storage file_system {
		root {$CADDY_DATA_DIR:/var/lib/caddy}
	}
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

{$FOUNDATION_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file {$ACCESS_LOG:/var/log/caddy/access.json} {
			roll_size 100MiB
			roll_keep 10
		}
		format json
	}

	reverse_proxy 127.0.0.1:{$ACTIVE_APP_PORT} {
		health_uri /health/ready
		health_interval 10s
		health_timeout 2s
		health_status 200
		health_passes 2
		health_fails 3

		lb_try_duration 5s
		lb_try_interval 250ms

		header_up X-Foundation-Proxy caddy
	}
}
