# Public application origin
APP_ORIGIN=http://localhost:5173

# Required in production for signed fallback sessions and internal integrity
SESSION_SECRET=replace-with-at-least-32-random-characters

# Public browser configuration for the optional shared-world client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase project and server-only service key
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=mirror-cartographer-private

# Public support and commercial pathways
KOFI_URL=https://ko-fi.com/mirrorcartographer/commissions
SPONSOR_URL=
CONSULTATION_URL=

# Runtime limits
MAX_JSON_BYTES=1000000
MAX_UPLOAD_BYTES=25000000
LIST_PAGE_SIZE=100
