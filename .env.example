# Public browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Never prefix OpenAI secrets with VITE_.
# Add OPENAI_API_KEY only to protected server-side Vercel environment variables.
OPENAI_API_KEY=YOUR_SERVER_SIDE_OPENAI_PROJECT_KEY
