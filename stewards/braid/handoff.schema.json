{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrorcartographer.local/schemas/steward-braid-handoff-v1.json",
  "title": "Steward Braid Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "task_id",
    "source_steward",
    "target_steward",
    "relationship",
    "artifact_paths",
    "evidence",
    "acceptance_criteria",
    "privacy_class",
    "rollback",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "cycle_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
    "source_steward": { "enum": ["research", "resources", "art", "build", "integration"] },
    "target_steward": { "enum": ["research", "resources", "art", "build", "integration"] },
    "relationship": { "enum": ["extends", "repairs", "consumes", "independent"] },
    "artifact_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "strength"],
        "properties": {
          "kind": { "enum": ["source", "test", "artifact", "decision", "observation"] },
          "reference": { "type": "string", "minLength": 1 },
          "strength": { "enum": ["low", "medium", "high"] }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "contradictions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "privacy_class": { "const": "public-safe" },
    "rollback": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
