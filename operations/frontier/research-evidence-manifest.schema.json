{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrorcartographer.dev/schemas/research-evidence-manifest.schema.json",
  "title": "Frontier Research Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "queue_item",
    "owner",
    "created_at",
    "sources",
    "claims",
    "falsification",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_id": { "type": "string", "pattern": "^[A-Z]+-[0-9]+:[a-z0-9-]+$" },
    "queue_item": { "type": "string", "pattern": "^R-[0-9]{3}$" },
    "owner": { "const": "frontier_research" },
    "created_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "status", "locator", "accessed_at"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["primary", "secondary", "repository", "experiment"] },
          "status": { "enum": ["verified", "provisional", "superseded", "unavailable"] },
          "locator": { "type": "string", "minLength": 1 },
          "accessed_at": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "inferred", "proposed", "superseded", "unresolved"],
      "properties": {
        "observed": { "$ref": "#/$defs/claimList" },
        "inferred": { "$ref": "#/$defs/claimList" },
        "proposed": { "$ref": "#/$defs/claimList" },
        "superseded": { "$ref": "#/$defs/claimList" },
        "unresolved": { "$ref": "#/$defs/claimList" }
      }
    },
    "falsification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_claim_ids", "test", "failure_condition"],
      "properties": {
        "target_claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "test": { "type": "string", "minLength": 1 },
        "failure_condition": { "type": "string", "minLength": 1 },
        "reproduction": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not_run", "partial"] },
        "method": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "limits": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "claimList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "source_ids", "strength"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "source_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "strength": { "enum": ["direct", "strong", "moderate", "weak", "unknown"] }
        }
      }
    }
  }
}
