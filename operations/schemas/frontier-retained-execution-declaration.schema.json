{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrorcartographer.local/schemas/frontier-retained-execution-declaration.schema.json",
  "title": "Retained execution declaration binding",
  "type": "object",
  "required": ["commit_sha", "primary", "independent"],
  "properties": {
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "primary": { "$ref": "#/$defs/method" },
    "independent": { "$ref": "#/$defs/method" }
  },
  "additionalProperties": true,
  "$defs": {
    "method": {
      "type": "object",
      "required": [
        "execution",
        "execution_declaration_path",
        "execution_declaration_sha256",
        "raw_output_path",
        "raw_output_sha256"
      ],
      "properties": {
        "execution": { "$ref": "#/$defs/execution" },
        "execution_declaration_path": { "type": "string", "minLength": 1 },
        "execution_declaration_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "raw_output_path": { "type": "string", "minLength": 1 },
        "raw_output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": [
        "client_id",
        "client_version",
        "invocation_id",
        "runner_id",
        "commit_sha",
        "started_at",
        "completed_at",
        "command_argv",
        "environment_class"
      ],
      "properties": {
        "client_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "client_version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "invocation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "runner_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "command_argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "environment_class": { "const": "authenticated_repository_read" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "description": "The primary and independent declaration paths must resolve to different retained files. Their SHA-256 values bind exact bytes. Runtime verification must parse each retained declaration and require deep equality with the corresponding inline execution object."
    }
  ]
}
