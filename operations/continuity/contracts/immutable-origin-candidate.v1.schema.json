{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrorcartographer.invalid/operations/continuity/contracts/immutable-origin-candidate.v1.schema.json",
  "title": "Immutable Origin Candidate",
  "description": "Fail-closed provenance contract for evaluating a claimed historical origin without reconstructing unverified history.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "subject_identifier",
    "repository",
    "commit_sha",
    "path",
    "blob_sha",
    "assignment_evidence",
    "coverage_envelope",
    "agreement",
    "claim_classification",
    "privacy_class",
    "verification_status",
    "falsification_route"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "subject_identifier": { "enum": ["M-004", "M-005", "M-006"] },
    "repository": { "const": "MirrorCartographer/mirror-cartographer-ui" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "minLength": 1 },
    "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "assignment_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_identifier_assignment", "namespace", "owner", "semantic_role", "assigned_at_or_before"],
      "properties": {
        "exact_identifier_assignment": { "const": true },
        "namespace": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "semantic_role": { "type": "string", "minLength": 1 },
        "assigned_at_or_before": { "type": "string", "format": "date-time" }
      }
    },
    "coverage_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refs_enumerated", "reachable_commits_traversed", "historical_paths_checked", "deleted_paths_checked", "retrieved_at", "known_blind_spots"],
      "properties": {
        "refs_enumerated": { "type": "boolean" },
        "reachable_commits_traversed": { "type": "boolean" },
        "historical_paths_checked": { "type": "boolean" },
        "deleted_paths_checked": { "type": "boolean" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "known_blind_spots": { "type": "array", "items": { "type": "string" } }
      }
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "owner", "semantic_role", "temporal_precedence", "immutable_locator", "no_conflicting_accepted_origin"],
      "properties": {
        "namespace": { "type": "boolean" },
        "owner": { "type": "boolean" },
        "semantic_role": { "type": "boolean" },
        "temporal_precedence": { "type": "boolean" },
        "immutable_locator": { "type": "boolean" },
        "no_conflicting_accepted_origin": { "type": "boolean" }
      }
    },
    "claim_classification": { "enum": ["observed", "inferred", "proposed", "superseded", "unresolved"] },
    "privacy_class": { "enum": ["public_repository_metadata", "public_safe_abstract_rule", "restricted_source_locator"] },
    "verification_status": { "enum": ["candidate", "quarantined", "verified_origin", "rejected"] },
    "falsification_route": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "verification_status": { "const": "verified_origin" } } },
      "then": {
        "properties": {
          "claim_classification": { "const": "observed" },
          "coverage_envelope": {
            "properties": {
              "refs_enumerated": { "const": true },
              "reachable_commits_traversed": { "const": true },
              "historical_paths_checked": { "const": true },
              "deleted_paths_checked": { "const": true },
              "known_blind_spots": { "maxItems": 0 }
            }
          },
          "agreement": {
            "properties": {
              "namespace": { "const": true },
              "owner": { "const": true },
              "semantic_role": { "const": true },
              "temporal_precedence": { "const": true },
              "immutable_locator": { "const": true },
              "no_conflicting_accepted_origin": { "const": true }
            }
          }
        }
      }
    }
  ]
}
