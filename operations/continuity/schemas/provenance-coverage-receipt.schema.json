{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrorcartographer.local/schemas/provenance-coverage-receipt.schema.json",
  "title": "Continuity Provenance Coverage Receipt",
  "description": "Fail-closed evidence contract required before a continuity artifact may be classified as unlocated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "repository",
    "generated_at",
    "tool_identity",
    "target_identifiers",
    "ref_inventory",
    "history_traversal",
    "source_classes",
    "coverage_result",
    "claim_transitions",
    "privacy_boundary",
    "known_exclusions",
    "reproduction"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "pattern": "^CM-COVERAGE-[0-9]{4,}$" },
    "repository": { "const": "MirrorCartographer/mirror-cartographer-ui" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version_or_runtime", "authentication_scope"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version_or_runtime": { "type": "string", "minLength": 1 },
        "authentication_scope": { "type": "string", "enum": ["authenticated_repository", "public_repository", "connector_limited"] }
      }
    },
    "target_identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^M-[0-9]{3}$" }
    },
    "ref_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "complete", "refs"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "complete": { "type": "boolean" },
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "object_sha", "kind"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "object_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "kind": { "type": "string", "enum": ["branch", "tag", "remote_tracking", "other"] }
            }
          }
        }
      }
    },
    "history_traversal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "complete", "reachable_commit_count", "searched_object_types", "command_or_procedure"],
      "properties": {
        "method": { "type": "string", "enum": ["git_rev_list_all_objects", "authenticated_api_graph_walk", "equivalent_documented_traversal"] },
        "complete": { "type": "boolean" },
        "reachable_commit_count": { "type": "integer", "minimum": 0 },
        "searched_object_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["commit", "tree", "blob", "tag"] }
        },
        "command_or_procedure": { "type": "string", "minLength": 1 }
      }
    },
    "source_classes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "searched", "method", "result_count"],
        "properties": {
          "class": { "type": "string", "enum": ["decision_log", "language_lexicon", "project_document", "continuity_artifact", "chat_history", "file_library", "other"] },
          "searched": { "type": "boolean" },
          "method": { "type": "string", "minLength": 1 },
          "result_count": { "type": "integer", "minimum": 0 },
          "privacy_reviewed": { "type": "boolean" }
        }
      }
    },
    "coverage_result": {
      "type": "string",
      "enum": ["complete", "incomplete", "complete_with_declared_exclusions"]
    },
    "claim_transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "prior_status", "next_status", "immutable_locator", "reason"],
        "properties": {
          "identifier": { "type": "string", "pattern": "^M-[0-9]{3}$" },
          "prior_status": { "type": "string", "enum": ["observed", "inferred", "proposed", "superseded", "unresolved", "located", "unlocated"] },
          "next_status": { "type": "string", "enum": ["unresolved", "located", "unlocated"] },
          "immutable_locator": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "privacy_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included_classes", "excluded_classes", "redaction_applied"],
      "properties": {
        "included_classes": { "type": "array", "items": { "type": "string" } },
        "excluded_classes": { "type": "array", "items": { "type": "string" } },
        "redaction_applied": { "type": "boolean" }
      }
    },
    "known_exclusions": { "type": "array", "items": { "type": "string" } },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "expected_evidence"],
      "properties": {
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "expected_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "coverage_result": { "const": "incomplete" } } },
      "then": {
        "properties": {
          "claim_transitions": {
            "items": { "properties": { "next_status": { "const": "unresolved" } } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_transitions": {
            "contains": { "properties": { "next_status": { "const": "unlocated" } }, "required": ["next_status"] }
          }
        }
      },
      "then": {
        "properties": {
          "coverage_result": { "const": "complete" },
          "ref_inventory": { "properties": { "complete": { "const": true } } },
          "history_traversal": { "properties": { "complete": { "const": true } } },
          "known_exclusions": { "maxItems": 0 }
        }
      }
    }
  ]
}
