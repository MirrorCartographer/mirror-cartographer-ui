{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operations/continuity/schemas/exhaustive-provenance-traversal.schema.json",
  "title": "Exhaustive Provenance Traversal Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "captured_at",
    "head_commit",
    "ref_inventory",
    "reachable_commit_inventory",
    "identifier_results",
    "coverage_status",
    "privacy_class",
    "falsification_route"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"const": "MirrorCartographer/mirror-cartographer-ui"},
    "captured_at": {"type": "string", "format": "date-time"},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ref_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "raw_path", "sha256", "refs", "complete"],
      "properties": {
        "command": {"const": "git for-each-ref --format=%(refname)%00%(objectname) refs/heads refs/remotes refs/tags"},
        "raw_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "object_id"],
            "properties": {
              "name": {"type": "string", "pattern": "^refs/(heads|remotes|tags)/"},
              "object_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        },
        "complete": {"const": true}
      }
    },
    "reachable_commit_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "raw_path", "sha256", "commit_count", "complete"],
      "properties": {
        "command": {"const": "git rev-list --all --topo-order --reverse"},
        "raw_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "commit_count": {"type": "integer", "minimum": 1},
        "complete": {"const": true}
      }
    },
    "identifier_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["M-004", "M-005", "M-006"],
      "properties": {
        "M-004": {"$ref": "#/$defs/identifierResult"},
        "M-005": {"$ref": "#/$defs/identifierResult"},
        "M-006": {"$ref": "#/$defs/identifierResult"}
      }
    },
    "coverage_status": {"enum": ["exhaustive_no_origin_found", "exhaustive_origin_found", "incomplete"]},
    "privacy_class": {"const": "public_repository_metadata"},
    "falsification_route": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "identifierResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "searched_commits", "candidate_objects", "claim_status", "source_status"],
      "properties": {
        "identifier": {"enum": ["M-004", "M-005", "M-006"]},
        "searched_commits": {"type": "integer", "minimum": 1},
        "candidate_objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["commit", "path", "blob_sha", "classification", "reason"],
            "properties": {
              "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "path": {"type": "string", "minLength": 1},
              "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "classification": {"enum": ["accepted_origin", "later_reference", "status_materialization", "namespace_collision", "semantic_mismatch", "ambiguous"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "claim_status": {"enum": ["resolved", "unresolved"]},
        "source_status": {"enum": ["located", "unlocated_after_exhaustive_coverage", "coverage_incomplete"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"coverage_status": {"const": "incomplete"}}},
      "then": {
        "properties": {
          "identifier_results": {
            "properties": {
              "M-004": {"properties": {"source_status": {"const": "coverage_incomplete"}}},
              "M-005": {"properties": {"source_status": {"const": "coverage_incomplete"}}},
              "M-006": {"properties": {"source_status": {"const": "coverage_incomplete"}}}
            }
          }
        }
      }
    }
  ]
}
